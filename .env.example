# Copy to .env. Every value has a working default for local development.

# --- API (backend) ---
TRACEBENCH_ENV=development
TRACEBENCH_LOG_LEVEL=INFO
TRACEBENCH_LOG_JSON=false
TRACEBENCH_CORS_ORIGINS=["http://localhost:3105"]
TRACEBENCH_DATABASE_URL=postgresql+asyncpg://tracebench@127.0.0.1:5505/tracebench

# Auth (optional). With TRACEBENCH_API_TOKEN set, every POST/PUT/PATCH/DELETE under /api needs
# "Authorization: Bearer <token>"; reads stay open for the dashboard. TRACEBENCH_INGEST_TOKEN
# guards /v1/traces; OTel exporters send it via OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20<token>.
# TRACEBENCH_API_TOKEN=
# TRACEBENCH_INGEST_TOKEN=
# OTEL_EXPORTER_OTLP_HEADERS=

# Server-side eval runs (POST /api/eval-runs/execute) only call these host or host:port entries.
# Empty disables them in production; development also allows loopback. The CLI is unaffected.
TRACEBENCH_EVAL_TARGET_ALLOWLIST=[]

# docker-compose only: database credentials (required there, unused by the local scripts)
CLICKHOUSE_PASSWORD=change-me
POSTGRES_PASSWORD=change-me

# ClickHouse HTTP interface (the local script runs it on 27105; docker-compose maps 8123 -> 27105)
TRACEBENCH_CLICKHOUSE_HOST=127.0.0.1
TRACEBENCH_CLICKHOUSE_PORT=27105
TRACEBENCH_CLICKHOUSE_USER=tracebench
TRACEBENCH_CLICKHOUSE_PASSWORD=tracebench
TRACEBENCH_CLICKHOUSE_DATABASE=tracebench
TRACEBENCH_SPAN_TTL_DAYS=30

# Ingest batching: flush when a batch fills up or the interval passes, whichever comes first
TRACEBENCH_INGEST_MAX_BATCH_SIZE=5000
TRACEBENCH_INGEST_FLUSH_INTERVAL_SECONDS=1.0
TRACEBENCH_INGEST_MAX_PENDING_SPANS=200000

# Scorers: fastembed downloads BAAI/bge-small-en-v1.5 once (~70 MB) and falls back to hashing offline
TRACEBENCH_EMBEDDINGS_BACKEND=fastembed
# TRACEBENCH_EMBEDDINGS_CACHE_DIR=/path/to/model/cache
# offline = deterministic token-overlap judge, anthropic = Claude as the LLM judge
TRACEBENCH_JUDGE_BACKEND=offline
TRACEBENCH_JUDGE_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# --- CLI ---
TRACEBENCH_API_URL=http://localhost:8105
TRACEBENCH_UI_URL=http://localhost:3105

# --- Demo apps (examples/) ---
# mock runs without an API key; anthropic calls Claude for real
DEMO_PROVIDER=mock
DEMO_OTLP_ENDPOINT=http://localhost:8105/v1/traces
DEMO_AGENT_MODEL=claude-sonnet-5-5
DEMO_ROUTER_MODEL=claude-haiku-4-5
DEMO_TRIAGE_MODEL=claude-haiku-4-5
DEMO_AGENT_VARIANT=v1

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8105
# Only for a UI that is itself behind your SSO/VPN: this value is compiled into the browser bundle.
# NEXT_PUBLIC_API_TOKEN=
